# Printer credentials (LAN mode / Developer Mode required on the printer)
BAMBU_IP=192.168.1.50
BAMBU_SERIAL=01P00A000000000
BAMBU_ACCESS_CODE=12345678

# Shared secret the widget sends as: Authorization: Bearer <API_TOKEN>
# Leave empty (or set to "auto") and the bridge generates one on first start,
# persists it to API_TOKEN_FILE, and prints it in the log on every boot.
# Set an explicit value here only if you want to choose your own token.
API_TOKEN=auto

# Where a generated token is stored (mounted as a volume by docker-compose)
API_TOKEN_FILE=/app/data/api_token

# Server
PORT=8083
BAMBU_POLL=1.0

# Set to 1 to serve simulated data without a printer (useful for testing)
BAMBU_MOCK=0
