# Printer credentials (LAN mode / Developer Mode required on the printer)
BAMBU_IP=192.168.1.50
BAMBU_SERIAL=01P00A000000000
BAMBU_ACCESS_CODE=12345678

# Shared secret the widget sends as: Authorization: Bearer <API_TOKEN>
# Generate one with: openssl rand -hex 32
API_TOKEN=change-me-to-a-long-random-string

# Server
PORT=8083
BAMBU_POLL=1.0

# Set to 1 to serve simulated data without a printer (useful for testing)
BAMBU_MOCK=0
